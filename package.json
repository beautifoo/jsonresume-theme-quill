{
	"name": "jsonresume-theme-quill",
	"version": "1.0.0",
	"keywords": [
		"jsonresume",
		"jsonresume-theme",
		"resume",
		"cv",
		"react",
		"theme"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/beautifoo/jsonresume-theme-quill.git"
	},
	"license": "MIT",
	"author": "Lorenzo Pieri",
	"type": "module",
	"main": "dist/index.js",
	"exports": {
		".": "./dist/index.js"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"build": "bun run build.ts",
		"check": "bunx @biomejs/biome check --write",
		"dev": "bun --hot src/index.tsx",
		"format": "bunx @biomejs/biome format --write",
		"lint": "bunx @biomejs/biome lint --write",
		"test": "bun test",
		"validate": "bun src/validate/cli.ts",
		"prepublishOnly": "bun run build",
		"typecheck": "bunx tsc --noEmit",
		"start": "NODE_ENV=production bun src/index.tsx",
		"test:browser": "playwright test"
	},
	"dependencies": {},
	"devDependencies": {
		"@biomejs/biome": "2.1.3",
		"@happy-dom/global-registrator": "21.0.4",
		"@jsonresume/schema": "1.7.1",
		"@jsonresume/types": "0.6.1",
		"@phosphor-icons/react": "2.1.10",
		"@playwright/test": "1.65.0",
		"@semantic-release/changelog": "7.0.0",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/git": "11.0.1",
		"@semantic-release/github": "^12.0.8",
		"@semantic-release/npm": "^13.1.5",
		"@semantic-release/release-notes-generator": "^14.1.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/bun": "1.4.5",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"bun-plugin-tailwind": "0.0.15",
		"clsx": "2.1.1",
		"happy-dom": "21.0.4",
		"playwright": "1.65.0",
		"react": "^19",
		"react-dom": "^19",
		"react-markdown": "10.1.0",
		"remark-gfm": "4.0.1",
		"semantic-release": "^25.0.5",
		"tailwind-merge": "3.3.1",
		"tailwindcss": "4.1.11",
		"use-intl": "4.3.4",
		"valibot": "1.5.0"
	},
	"release": {
		"branches": [
			"main"
		],
		"plugins": [
			"@semantic-release/commit-analyzer",
			"@semantic-release/release-notes-generator",
			[
				"@semantic-release/changelog",
				{
					"changelogTitle": "# Changelog"
				}
			],
			[
				"@semantic-release/git",
				{
					"assets": [
						"CHANGELOG.md"
					]
				}
			],
			"@semantic-release/npm",
			[
				"@semantic-release/github",
				{
					"assets": [
						"CHANGELOG.md"
					]
				}
			]
		]
	}
}
